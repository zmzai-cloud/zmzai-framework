{
  "name": "@zmzai/agent-framework",
  "version": "0.1.0",
  "description": "PI-based agent framework — sessions, permissions, tools, runner, events (OpenCode-style).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zmzai-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:watch": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.25.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
